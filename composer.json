{
    "name": "nvl/auth",
    "description": "Configurable, extensible authentication features for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authentication",
        "authorization",
        "invitations",
        "magic-links",
        "passkeys",
        "totp"
    ],
    "require": {
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^7.0",
        "php": "^8.4",
        "symfony/http-foundation": "^7.4.19 || ^8.1.7"
    },
    "require-dev": {
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.29",
        "mockery/mockery": "^1.6",
        "nvl/ownership": "^7.0",
        "orchestra/testbench": "^11.0",
        "paragonie/constant_time_encoding": "^2.6 || ^3.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pragmarx/google2fa": "^9.0",
        "spatie/laravel-permission": "^8.0",
        "spomky-labs/cbor-php": "^3.0",
        "symfony/process": "^7.0 || ^8.0",
        "symfony/serializer": "^7.2 || ^8.0",
        "symfony/uid": "^7.2 || ^8.0",
        "web-auth/cose-lib": "^4.2.3",
        "web-auth/webauthn-lib": "^5.3"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Renders server-side QR codes for TOTP provisioning when a headless URI is not sufficient.",
        "laravel/sanctum": "Enables the explicitly selected API token adapter.",
        "laravel/socialite": "Enables the optional OAuth identity adapter.",
        "nvl/activity": "Can consume the package's after-commit audit and authentication events.",
        "nvl/mail-notifications": "Can consume AuthDeliveryRequested events and deliver the typed payloads.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "paragonie/constant_time_encoding": "Required by the selected WebAuthn passkey adapter.",
        "pragmarx/google2fa": "Enables the audited TOTP engine when selected.",
        "spatie/laravel-permission": "Enables the explicitly selected permission and role adapter.",
        "symfony/serializer": "Required by the selected WebAuthn passkey adapter.",
        "symfony/uid": "Required by the selected WebAuthn passkey adapter.",
        "web-auth/webauthn-lib": "Enables the audited WebAuthn passkey adapter."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Auth\\": "src/",
            "Nvl\\Auth\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Auth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test:parallel"
        ],
        "test": "pest --compact",
        "test:feature": "pest --compact --testsuite=feature",
        "test:unit": "pest --compact --testsuite=unit",
        "test:parallel": "pest --compact --parallel --processes=4"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Auth\\Providers\\AuthServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.path-coverage.xml",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "nvl/activity": "<7.0 || >=8.0",
        "nvl/mail-notifications": "<7.0 || >=8.0",
        "nvl/ownership": "<7.0 || >=8.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/auth",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/auth",
        "docs": "https://github.com/nvl-laravel-suite/auth#readme",
        "issues": "https://github.com/nvl-laravel-suite/auth/issues",
        "security": "https://github.com/nvl-laravel-suite/auth/security/policy"
    }
}
